---
// src/layouts/BaseLayout.astro
---
<html lang="pt-br">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>TECHNOVA | Premium Store</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
	</head>
	<body>
		<div id="custom-cursor"></div>

		<div id="cart-sidebar" class="sidebar">
			<div class="sidebar-header">
				<h3>ECOSSISTEMA</h3>
				<button id="close-cart">×</button>
			</div>
			<div id="cart-items"></div>
			<div class="sidebar-footer">
				<div class="total-row"><span>TOTAL</span><span id="cart-total">R$ 0,00</span></div>
				<button class="checkout-btn">FINALIZAR ORDEM</button>
			</div>
		</div>

		<nav class="navbar">
			<div class="logo" onclick="window.location.href='/'" style="cursor:pointer">TECH<span>NOVA</span></div>
			<div class="nav-links">
				<a href="/shop" class="nav-item magnetic">SHOP</a>
				<a href="/labs" class="nav-item magnetic">LABS</a>
			</div>
			<button class="cart-trigger magnetic" id="open-cart">CART [<span id="cart-count">0</span>]</button>
		</nav>

        <slot /> <!-- AS PÁGINAS VÃO APARECER AQUI -->

        <div class="ai-trigger-wrapper" id="toggleChat">
            <div class="ai-orb"><div class="orb-rings"></div><div class="orb-core"></div></div>
            <span class="orb-label">SUPORTE</span>
        </div>
        <div class="chat-window" id="chatWindow">
            <div class="chat-header">
                <div class="header-content"><div class="status-dot"></div><div class="text-block"><span class="ai-title">Suporte</span><span class="ai-status">Online</span></div></div>
                <button id="closeChat" class="close-btn-chat">×</button>
            </div>
            <div class="messages" id="chatMessages"><div class="msg bot"><div class="bubble">Sistemas prontos.</div></div></div>
            <div class="chat-input-group">
                <div class="input-wrapper">
                    <input type="text" id="userInput" placeholder="Dúvida?">
                    <button id="sendBtn" class="send-icon-btn">➤</button>
                </div>
            </div>
        </div>

		<style is:global>
			:root { --bg: #030303; --accent: #00f2ff; --accent-2: #7000ff; }
			* { margin: 0; padding: 0; box-sizing: border-box; cursor: none !important; }
			body { background: var(--bg); color: white; font-family: 'Inter', sans-serif; overflow-x: hidden; }
			#custom-cursor { position: fixed; top: 0; left: 0; width: 12px; height: 12px; background: var(--accent); border-radius: 50%; pointer-events: none; z-index: 10000; mix-blend-mode: difference; transform: translate(-50%, -50%); opacity: 0; transition: width 0.3s, opacity 0.3s; }
			.navbar { position: fixed; width: 100%; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 30px 5%; backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.05); }
			.logo { font-weight: 900; letter-spacing: 3px; } .logo span { color: var(--accent); }
			.nav-links { display: flex; gap: 50px; } .nav-item { text-decoration: none; color: white; font-size: 0.7rem; font-weight: 700; letter-spacing: 2px; opacity: 0.5; }
			.cart-trigger { background: white; color: black; border: none; padding: 12px 25px; border-radius: 50px; font-weight: 900; font-size: 0.65rem; }
			.sidebar { position: fixed; right: -450px; top: 0; width: 450px; height: 100vh; background: #050505; z-index: 2000; padding: 50px; transition: 0.6s cubic-bezier(0.85, 0, 0.15, 1); border-left: 1px solid rgba(255,255,255,0.05); }
			.sidebar.active { right: 0; }
            .ai-trigger-wrapper { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; align-items: center; gap: 5px; z-index: 1000; cursor: pointer; }
            .orb-core { width: 30px; height: 30px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 25px var(--accent); }
            .chat-window { position: fixed; bottom: 100px; right: 30px; width: 360px; height: 500px; background: rgba(10,10,10,0.95); backdrop-filter: blur(25px); border-radius: 25px; border: 1px solid rgba(255,255,255,0.1); display: none; flex-direction: column; z-index: 1001; }
            .messages { flex: 1; overflow-y: auto; padding: 20px; font-size: 0.85rem; }
            .bubble { padding: 12px; border-radius: 15px; background: rgba(255,255,255,0.05); margin-bottom: 10px; }
		</style>

        <script is:inline>
            // Lógica Global (Cursor, Chat, Carrinho)
            const cursor = document.getElementById('custom-cursor');
            document.addEventListener('mousemove', (e) => {
                cursor.style.opacity = "1";
                gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0.1 });
            });

            let cart = [];
            window.addToCart = (name, price) => {
                cart.push({name, price});
                document.getElementById('cart-count').innerText = cart.length;
                document.getElementById('cart-sidebar').classList.add('active');
            };

            const chatWin = document.getElementById('chatWindow');
            document.getElementById('toggleChat').onclick = () => chatWin.style.display = 'flex';
            document.getElementById('closeChat').onclick = () => chatWin.style.display = 'none';
            document.getElementById('open-cart').onclick = () => document.getElementById('cart-sidebar').classList.add('active');
            document.getElementById('close-cart').onclick = () => document.getElementById('cart-sidebar').classList.remove('active');
        </script>
	</body>
</html>