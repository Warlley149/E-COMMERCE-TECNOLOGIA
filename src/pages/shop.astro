---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
	<main class="shop-page">
		<h1 class="shop-title">CATÁLOGO <span>PRESTIGE</span></h1>
		<div class="product-grid" id="shop-grid">
			<!-- Injetado via JS -->
		</div>
	</main>
</BaseLayout>

<style>
	.shop-page { padding: 150px 5% 50px; }
	.shop-title { font-size: 4rem; font-weight: 900; letter-spacing: -3px; margin-bottom: 50px; }
	.shop-title span { color: var(--accent); }
	.product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; }
</style>

<script is:inline>
	const products = [
		{ id: 'nova-book', name: "NOVA BOOK ULTRA", price: "R$ 18.900,00", img: "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?q=80&w=500" },
		{ id: 'quantum-gpu', name: "QUANTUM GPU X", price: "R$ 7.500,00", img: "https://images.unsplash.com/photo-1591488320449-011701bb6704?q=80&w=500" },
		{ id: 'cyber-watch', name: "CYBER WATCH S", price: "R$ 3.200,00", img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=500" }
	];

	const grid = document.getElementById('shop-grid');
	products.forEach(p => {
		const card = document.createElement('div');
		card.style.cssText = "background:rgba(255,255,255,0.02); padding:40px; border-radius:30px; border:1px solid rgba(255,255,255,0.05); position:relative;";
		card.innerHTML = `
			<img src="${p.img}" style="width:100%; border-radius:20px; cursor:pointer" onclick="window.location.href='/product/${p.id}'" />
			<h3 style="margin-top:20px">${p.name}</h3>
			<p style="color:var(--accent)">${p.price}</p>
			<button onclick="addToCart('${p.name}', '${p.price}')" style="margin-top:20px; width:100%; padding:15px; background:white; color:black; border:none; font-weight:900; border-radius:10px;">ADICIONAR</button>
		`;
		grid.appendChild(card);
	});
</script>