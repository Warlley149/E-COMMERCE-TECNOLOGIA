---
import BaseLayout from '../layouts/BaseLayout.astro';

const catalogProducts = [
  { id: 'nova-book', name: "NOVA BOOK ULTRA", price: "R$ 18.900,00", category: "Laptops", img: "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?q=80&w=500" },
  { id: 'quantum-gpu', name: "QUANTUM GPU X", price: "R$ 7.500,00", category: "Componentes", img: "https://images.unsplash.com/photo-1591488320449-011701bb6704?q=80&w=500" },
  { id: 'cyber-watch', name: "CYBER WATCH S", price: "R$ 3.200,00", category: "Wearables", img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=500" },
  { id: 'neural-phone', name: "NEURAL PHONE PRO", price: "R$ 9.400,00", category: "Mobile", img: "https://images.unsplash.com/photo-1598327105666-5b89351aff97?q=80&w=500" },
  { id: 'void-pc', name: "VOID RIG QUANTUM", price: "R$ 29.800,00", category: "Desktops", img: "https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&q=80&w=600" },
  { id: 'cyber-display', name: "CYBER DISPLAY 8K", price: "R$ 14.500,00", category: "Monitores", img: "https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?q=80&w=500" }
];
---

<BaseLayout title="TECHNOVA | Catálogo Prestige">
	<main class="shop-container">
		<header class="shop-header">
			<div class="badge">ECOSSISTEMA 2026</div>
			<h1 class="shop-title">CATÁLOGO <span>PRESTIGE</span></h1>
			<p class="shop-subtitle">Explore a mais avançada linha de equipamentos quânticos e hardware de elite.</p>
		</header>

		<section class="shop-grid">
			{catalogProducts.map(p => (
				<div class="shop-card">
					<div class="card-img-box" onclick={`window.location.href='/product/${p.id}'`}>
						<span class="category-pill">{p.category}</span>
						<img src={p.img} class="product-image" alt={p.name} />
					</div>
					<div class="card-meta">
						<h3 onclick={`window.location.href='/product/${p.id}'`}>{p.name}</h3>
						<p class="price-val">{p.price}</p>
						<button class="buy-btn" onclick={`addToCart('${p.name}', '${p.price}')`}>
							ADICIONAR À ORDEM
						</button>
					</div>
				</div>
			))}
		</section>
	</main>
</BaseLayout>

<style>
	.shop-container { padding: 150px 5% 100px; min-height: 100vh; }
	.shop-header { margin-bottom: 60px; max-width: 700px; }
	.badge { font-size: 0.6rem; letter-spacing: 3px; color: var(--accent); margin-bottom: 15px; border: 1px solid var(--accent); display: inline-block; padding: 5px 15px; border-radius: 50px; }
	.shop-title { font-size: clamp(3rem, 6vw, 5rem); font-weight: 900; letter-spacing: -3px; line-height: 0.9; margin-bottom: 20px; }
	.shop-title span { color: var(--accent); }
	.shop-subtitle { color: #888; font-size: 1.1rem; line-height: 1.6; }

	.shop-grid { 
		display: grid; 
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); 
		gap: 40px; 
	}

	.shop-card { 
		background: rgba(255,255,255,0.02); 
		border: 1px solid rgba(255,255,255,0.06); 
		border-radius: 30px; 
		padding: 30px; 
		display: flex; 
		flex-direction: column; 
		justify-content: space-between;
		transition: all 0.4s cubic-bezier(0.2, 1, 0.2, 1);
	}
	.shop-card:hover { 
		border-color: rgba(0, 242, 255, 0.4); 
		transform: translateY(-8px);
		box-shadow: 0 20px 40px rgba(0,0,0,0.6);
	}

	.card-img-box {
		width: 100%;
		height: 250px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		cursor: pointer;
	}

	.category-pill {
		position: absolute;
		top: 0;
		left: 0;
		font-size: 0.6rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #888;
		border: 1px solid rgba(255,255,255,0.1);
		padding: 4px 10px;
		border-radius: 20px;
	}

	.product-image {
		max-width: 85%;
		max-height: 90%;
		object-fit: contain;
		filter: drop-shadow(0 15px 25px rgba(0,0,0,0.7));
		transition: transform 0.5s;
	}
	.shop-card:hover .product-image { transform: scale(1.06); }

	.card-meta {
		text-align: center;
		margin-top: 20px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.card-meta h3 {
		font-weight: 900;
		font-size: 1.4rem;
		letter-spacing: -0.5px;
		cursor: pointer;
		margin-bottom: 6px;
		transition: color 0.3s;
	}
	.card-meta h3:hover { color: var(--accent); }

	.price-val {
		color: var(--accent);
		font-weight: 700;
		font-size: 1.1rem;
		margin-bottom: 20px;
	}

	.buy-btn { 
		width: 100%;
		max-width: 280px;
		background: rgba(0, 242, 255, 0.06); 
		border: 1.5px solid var(--accent); 
		color: var(--accent); 
		padding: 15px 24px; 
		border-radius: 50px; 
		font-family: 'Inter', sans-serif;
		font-weight: 900; 
		font-size: 0.72rem;
		letter-spacing: 3px; 
		text-transform: uppercase;
		cursor: pointer;
		outline: none;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 0 20px rgba(0, 242, 255, 0.2);
	}
	.buy-btn:hover { 
		background: var(--accent); 
		color: #000000; 
		transform: translateY(-3px) scale(1.02);
		box-shadow: 0 0 35px rgba(0, 242, 255, 0.7);
	}
</style>