---
// TECHNOVA - EDIÇÃO DEFINITIVA (SSR NATIVO + CSS ULTRA HD)
const products = [
  { name: "NOVA BOOK ULTRA", price: "R$ 18.900,00", img: "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?q=80&w=500" },
  { name: "QUANTUM GPU X", price: "R$ 7.500,00", img: "https://images.unsplash.com/photo-1591488320449-011701bb6704?q=80&w=500" },
  { name: "CYBER WATCH S", price: "R$ 3.200,00", img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=500" }
];
---

<html lang="pt-br">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>TECHNOVA | Prestige Tech Experience</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
	</head>
	<body>
		
		<div id="custom-cursor"></div>

		<!-- CARRINHO LATERAL -->
		<div id="cart-sidebar" class="sidebar">
			<div class="sidebar-header">
				<div class="sidebar-title-wrapper">
					<h3>ECOSSISTEMA</h3>
					<span class="sidebar-subtitle">Hardware selecionado</span>
				</div>
				<button id="close-cart" class="close-btn-sidebar" aria-label="Fechar carrinho">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<div id="cart-items" class="cart-scroll-area">
				<p class="empty-msg">Nenhum hardware detectado.</p>
			</div>
			<div class="sidebar-footer">
				<div class="total-row">
					<span>TOTAL</span>
					<span id="cart-total">R$ 0,00</span>
				</div>
				<button class="checkout-btn" onclick="window.location.href='/checkout'">FINALIZAR ORDEM</button>
			</div>
		</div>

		<!-- NAVBAR REFINADA -->
		<nav class="navbar">
			<div class="logo">TECH<span>NOVA</span></div>
			<div class="nav-links">
				<a href="/" class="nav-item magnetic">HOME</a>
				<a href="/shop" class="nav-item magnetic">SHOP</a>
				<a href="/labs" class="nav-item magnetic">LABS</a>
			</div>
			<button class="cart-trigger magnetic" id="open-cart">
				CART [<span id="cart-count">0</span>]
			</button>
		</nav>

		<main id="main-content">
			<section class="hero">
				<div class="hero-container">
					<div class="badge">ESTOQUE LIMITADO</div>
					<h1 class="reveal-text">TECH</h1>
					<h1 class="reveal-text gradient">PERFORMANCE</h1>
					<p class="hero-subtext">Engenharia quântica e design minimalista em um único ecossistema funcional.</p>
					<button class="cta-primary magnetic" onclick="window.location.href='/shop'">
						EXPLORAR PRODUTOS <span class="arrow">↓</span>
					</button>
				</div>
			</section>

			<!-- PRODUTOS RENDERIZADOS NATIVAMENTE -->
			<section class="products-section">
				<div class="section-header">
					<h2 class="section-label">EQUIPAMENTOS DE ELITE</h2>
					<div class="line"></div>
				</div>
				<div class="product-grid" id="grid">
					{products.map(p => (
						<div class="card">
							<div class="img-wrapper">
								<img src={p.img} class="prod-img" alt={p.name} />
							</div>
							<div class="card-info">
								<h3>{p.name}</h3>
								<p class="price-tag">{p.price}</p>
								<button class="buy-btn" onclick={`addToCart('${p.name}', '${p.price}')`}>
									ADICIONAR À ORDEM
								</button>
							</div>
						</div>
					))}
				</div>
			</section>
		</main>

		<!-- SUPORTE IA REFINADO -->
        <div class="ai-trigger-wrapper" id="toggleChat">
            <div class="ai-orb">
                <div class="orb-rings"></div>
                <div class="orb-core"></div>
            </div>
            <span class="orb-label">SUPORTE</span>
        </div>
        
        <div class="chat-window" id="chatWindow">
            <div class="chat-header">
                <div class="header-content">
                    <div class="status-dot"></div>
                    <div class="text-block">
                        <span class="ai-title">Suporte de Atendimento</span>
                        <span class="ai-status">Online agora</span>
                    </div>
                </div>
                <button id="closeChat" class="close-btn-chat">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div class="messages" id="chatMessages">
                <div class="msg bot">
                    <div class="bubble">Sistemas prontos. Como posso auxiliar em sua jornada?</div>
                </div>
            </div>

            <div class="chat-input-group">
				<div class="topic-selector">
					<select id="chatTopic" aria-label="Assunto do atendimento">
						<option value="geral">Dúvidas sobre produtos</option>
						<option value="devolucao">Devolução</option>
						<option value="problema_pedido">Problemas com o pedido</option>
						<option value="atendimento_humano">Atendimento humano</option>
					</select>
				</div>
                <div class="input-wrapper">
                    <input type="text" id="userInput" placeholder="Escreva sua dúvida...">
                    <button id="sendBtn" class="send-icon-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    </button>
                </div>
            </div>
        </div>

		<style is:global>
			:root {
				--bg: #030303;
				--accent: #00f2ff;
				--accent-2: #7000ff;
				--glass: rgba(255, 255, 255, 0.03);
			}

			* { margin: 0; padding: 0; box-sizing: border-box; cursor: none !important; }
			body { background: var(--bg); color: white; font-family: 'Inter', sans-serif; overflow-x: hidden; transition: background 0.6s cubic-bezier(0.2, 1, 0.2, 1); }

			/* CURSOR */
			#custom-cursor {
				position: fixed; top: 0; left: 0; width: 12px; height: 12px;
				background: var(--accent); border-radius: 50%; pointer-events: none;
				z-index: 10000; mix-blend-mode: difference; transform: translate(-50%, -50%);
				opacity: 0; transition: width 0.3s, opacity 0.3s;
			}

			/* NAVBAR */
			.navbar { position: fixed; width: 100%; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 30px 5%; backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.05); }
			.logo { font-weight: 900; letter-spacing: 3px; }
			.logo span { color: var(--accent); }
			.nav-links { display: flex; gap: 50px; }
			.nav-item { text-decoration: none; color: white; font-size: 0.7rem; font-weight: 700; letter-spacing: 2px; opacity: 0.5; transition: 0.3s; }
			.nav-item:hover { opacity: 1; color: var(--accent); }
			.cart-trigger { background: white; color: black; border: none; padding: 12px 25px; border-radius: 50px; font-weight: 900; font-size: 0.65rem; transition: 0.3s; }

			/* HERO */
			.hero { height: 100vh; display: flex; align-items: center; padding: 0 10%; }
			.badge { font-size: 0.6rem; letter-spacing: 3px; color: var(--accent); margin-bottom: 20px; border: 1px solid var(--accent); display: inline-block; padding: 5px 15px; border-radius: 50px; }
			h1 { font-size: clamp(4rem, 12vw, 9rem); font-weight: 900; line-height: 0.8; letter-spacing: -6px; }
			.gradient { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
			.hero-subtext { max-width: 450px; margin: 30px 0; color: #666; font-size: 1.1rem; line-height: 1.6; }
			
			.cta-primary { background: white; color: black; border: none; padding: 25px 50px; font-weight: 900; font-size: 0.8rem; letter-spacing: 2px; transition: 0.4s; }
			.cta-primary:hover { background: var(--accent); border-radius: 50px; }

			/* GRID E CARDS DE PRODUTO */
			.products-section { padding: 120px 5%; position: relative; z-index: 1; }
			.section-header { display: flex; align-items: center; gap: 20px; margin-bottom: 60px; }
			.section-label { font-size: 0.7rem; letter-spacing: 4px; color: #444; }
			.line { height: 1px; flex: 1; background: rgba(255,255,255,0.05); }
			
			.product-grid { 
				display: grid; 
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); 
				gap: 50px; 
			}

            .card { 
                background: rgba(255,255,255,0.02); 
                height: 580px; 
                border-radius: 35px; 
                border: 1px solid rgba(255,255,255,0.06);
                padding: 35px; 
                display: flex; 
                flex-direction: column; 
                justify-content: space-between; 
                align-items: center;
                transition: transform 0.6s cubic-bezier(0.2, 1, 0.2, 1), border-color 0.3s, opacity 0.5s; 
                position: relative; 
                overflow: hidden;
            }

			.img-wrapper {
				width: 100%;
				height: 280px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

            .prod-img { 
                max-width: 85%; 
				max-height: 100%;
				object-fit: contain;
                transition: transform 0.8s cubic-bezier(0.2, 1, 0.2, 1); 
                pointer-events: none;
				filter: drop-shadow(0 15px 30px rgba(0,0,0,0.6));
            }

			.card-info {
				text-align: center;
				width: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
				z-index: 2;
			}

			.card-info h3 {
				font-weight: 900;
				font-size: 1.6rem;
				letter-spacing: -0.5px;
				margin-bottom: 8px;
			}

			.price-tag {
				color: var(--accent);
				font-weight: 300;
				font-size: 1.1rem;
				margin-bottom: 25px;
			}

            /* BOTÃO ADICIONAR À ORDEM - ESTILO ULTRA DEFINITIVO */
			.buy-btn { 
				width: 100%;
				max-width: 280px;
				background: rgba(0, 242, 255, 0.06); 
				border: 1.5px solid var(--accent); 
				color: var(--accent); 
				padding: 16px 24px; 
				border-radius: 50px; 
				font-family: 'Inter', sans-serif;
				font-weight: 900; 
				font-size: 0.75rem;
				letter-spacing: 3px; 
				text-transform: uppercase;
				cursor: pointer;
				position: relative;
				overflow: hidden;
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				z-index: 10;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				outline: none;
				box-shadow: 0 0 20px rgba(0, 242, 255, 0.2);
			}

			.buy-btn:hover { 
				background: var(--accent); 
				color: #000000; 
				border-color: var(--accent);
				transform: translateY(-3px) scale(1.02);
				box-shadow: 0 0 35px rgba(0, 242, 255, 0.7), 0 10px 20px rgba(0, 0, 0, 0.5);
			}

			.buy-btn:active { 
				transform: translateY(0) scale(0.96);
			}

			/* SIDEBAR CARRINHO REFINADA */
			.sidebar { 
				position: fixed; 
				right: -450px; 
				top: 0; 
				width: 450px; 
				height: 100vh; 
				background: rgba(8, 8, 8, 0.95); 
				backdrop-filter: blur(30px);
				z-index: 2000; 
				padding: 40px; 
				transition: right 0.5s cubic-bezier(0.85, 0, 0.15, 1); 
				border-left: 1px solid rgba(255, 255, 255, 0.08); 
				box-shadow: -20px 0 60px rgba(0, 0, 0, 0.8);
				display: flex; 
				flex-direction: column; 
			}
			.sidebar.active { right: 0; }

			.sidebar-header { 
				display: flex; 
				justify-content: space-between; 
				align-items: center; 
				padding-bottom: 25px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}

			.sidebar-title-wrapper h3 {
				font-size: 1.1rem;
				font-weight: 900;
				letter-spacing: 2px;
				color: white;
				margin-bottom: 4px;
			}

			.sidebar-subtitle {
				font-size: 0.65rem;
				color: #666;
				letter-spacing: 1px;
				text-transform: uppercase;
			}

			.close-btn-sidebar { 
				background: rgba(255, 255, 255, 0.05); 
				border: 1px solid rgba(255, 255, 255, 0.1); 
				color: #aaa; 
				width: 36px; 
				height: 36px; 
				border-radius: 50%; 
				display: flex; 
				align-items: center; 
				justify-content: center; 
				cursor: pointer; 
				transition: 0.3s cubic-bezier(0.2, 1, 0.2, 1);
			}
			.close-btn-sidebar:hover { 
				background: rgba(255, 71, 87, 0.2); 
				border-color: #ff4757;
				color: #ff4757; 
				transform: rotate(90deg) scale(1.1); 
			}

			.cart-scroll-area { 
				flex: 1; 
				margin: 30px 0; 
				overflow-y: auto; 
				padding-right: 10px;
			}

			.total-row { 
				display: flex; 
				justify-content: space-between; 
				align-items: center;
				padding: 20px 0; 
				border-top: 1px solid rgba(255, 255, 255, 0.08); 
				font-weight: 900; 
				font-size: 1.1rem; 
				letter-spacing: 1px;
			}

			.total-row span:last-child {
				color: var(--accent);
			}

			.checkout-btn { 
				width: 100%; 
				padding: 20px; 
				background: var(--accent); 
				color: black; 
				border: none; 
				border-radius: 12px;
				font-weight: 900; 
				font-size: 0.8rem;
				letter-spacing: 2px; 
				cursor: pointer;
				transition: 0.3s;
			}
			.checkout-btn:hover {
				box-shadow: 0 0 30px rgba(0, 242, 255, 0.4);
				transform: translateY(-2px);
			}

			/* IA SUPORTE - DESIGN ULTRA HD */
            .ai-trigger-wrapper { 
                position: fixed; bottom: 30px; right: 30px; 
                display: flex; flex-direction: column; align-items: center; 
                gap: 8px; z-index: 1000; cursor: pointer; 
            }
            .ai-orb { width: 60px; height: 60px; position: relative; display: flex; align-items: center; justify-content: center; }
            .orb-core { width: 30px; height: 30px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 25px var(--accent); transition: 0.3s; }
            .ai-trigger-wrapper:hover .orb-core { transform: scale(1.2); box-shadow: 0 0 40px var(--accent); }
            .orb-rings { position: absolute; width: 100%; height: 100%; border: 1px solid var(--accent); border-radius: 50%; opacity: 0.3; animation: pulseRing 2s infinite; }
            @keyframes pulseRing { 0% { transform: scale(0.8); opacity: 0.8; } 100% { transform: scale(1.4); opacity: 0; } }
            .orb-label { font-size: 9px; font-weight: 900; letter-spacing: 2px; color: var(--accent); opacity: 0.8; }
            
            .chat-window { 
                position: fixed; bottom: 100px; right: 30px; 
                width: 360px; height: 500px; 
                background: rgba(10,10,10,0.8); backdrop-filter: blur(30px); 
                border-radius: 24px; border: 1px solid rgba(255,255,255,0.1); 
                display: none; flex-direction: column; z-index: 1001; 
                box-shadow: 0 20px 50px rgba(0,0,0,0.5); overflow: hidden;
            }

            .chat-header { padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; }
            .header-content { display: flex; align-items: center; gap: 12px; }
            .status-dot { width: 8px; height: 8px; background: #00ff88; border-radius: 50%; box-shadow: 0 0 10px #00ff88; }
            .ai-title { font-size: 0.85rem; font-weight: 800; color: white; display: block; }
            .ai-status { font-size: 0.7rem; color: #666; }
            
            .close-btn-chat { 
                background: rgba(255,255,255,0.05); border: none; color: white; 
                width: 32px; height: 32px; border-radius: 50%; 
                display: flex; align-items: center; justify-content: center; 
                cursor: pointer; transition: 0.3s;
            }
            .close-btn-chat:hover { background: #ff4757; transform: rotate(90deg); }

			.messages { flex: 1; overflow-y: auto; padding: 18px 16px; display: flex; flex-direction: column; gap: 18px; scrollbar-width: thin; scrollbar-color: rgba(0,242,255,0.35) transparent; }
			.msg { display: flex; flex-direction: column; gap: 5px; max-width: 92%; animation: messageIn 0.22s ease-out both; }
			.msg::before { font-size: 0.55rem; font-weight: 900; letter-spacing: 1.8px; }
			.msg.user { align-self: flex-end; align-items: flex-end; }
			.msg.user::before { content: 'VOCÊ'; color: #6edbe3; padding-right: 4px; }
			.msg.bot { align-self: flex-start; align-items: flex-start; }
			.msg.bot::before { content: 'TECHNOVA IA'; color: #718087; padding-left: 4px; }
			.bubble { padding: 11px 14px; border-radius: 14px; font-size: 0.82rem; line-height: 1.48; color: #d8e1e3; max-width: 100%; white-space: pre-line; }
			.user .bubble { background: rgba(0,242,255,0.16); border: 1px solid rgba(0,242,255,0.5); color: #e9feff; font-weight: 600; border-bottom-right-radius: 4px; }
			.bot .bubble { background: rgba(255,255,255,0.045); border: 1px solid rgba(255,255,255,0.1); border-bottom-left-radius: 4px; }
			@keyframes messageIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

			.chat-input-group { padding: 20px; background: rgba(0,0,0,0.2); }
			.topic-selector { position: relative; margin-bottom: 12px; }
			.topic-selector::before { content: 'ASSUNTO DO ATENDIMENTO'; display: block; margin: 0 0 7px 3px; color: #68747a; font-size: 0.56rem; font-weight: 900; letter-spacing: 2px; }
			.topic-selector::after { content: '↓'; position: absolute; right: 14px; bottom: 12px; color: var(--accent); font-size: 0.9rem; pointer-events: none; }
			#chatTopic { appearance: none; width: 100%; padding: 11px 38px 11px 14px; background: linear-gradient(105deg, rgba(0,242,255,0.09), rgba(255,255,255,0.035)); border: 1px solid rgba(0,242,255,0.28); border-radius: 11px; color: #d9faff; font: 700 0.68rem 'Inter', sans-serif; letter-spacing: 0.5px; outline: none; cursor: pointer; transition: border-color 0.25s, background 0.25s, box-shadow 0.25s; }
			#chatTopic:hover { border-color: rgba(0,242,255,0.65); background: linear-gradient(105deg, rgba(0,242,255,0.13), rgba(255,255,255,0.05)); }
			#chatTopic:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(0,242,255,0.1), 0 0 22px rgba(0,242,255,0.08); }
			#chatTopic option { background: #101719; color: #d9faff; }
            .input-wrapper { 
                display: flex; align-items: center; background: rgba(255,255,255,0.05); 
                padding: 6px 6px 6px 15px; border-radius: 50px; 
                border: 1px solid rgba(255,255,255,0.1); transition: 0.3s;
            }
            .input-wrapper:focus-within { border-color: var(--accent); background: rgba(255,255,255,0.08); }
            
            .input-wrapper input { 
                flex: 1; background: none; border: none; color: white; 
                font-size: 0.85rem; outline: none; font-family: 'Inter', sans-serif;
            }

            .send-icon-btn { 
                background: var(--accent); border: none; width: 36px; height: 36px; 
                border-radius: 50%; display: flex; align-items: center; justify-content: center; 
                cursor: pointer; color: black; transition: 0.3s;
            }
            .send-icon-btn:hover { transform: scale(1.1) rotate(-10deg); box-shadow: 0 0 15px var(--accent); }
		</style>

		<script is:inline>
            // 1. LÓGICA DO CARRINHO
            let cart = [];
            const updateCartUI = () => {
                const count = document.getElementById('cart-count');
                const items = document.getElementById('cart-items');
                const totalDisplay = document.getElementById('cart-total');
                count.innerText = cart.length;
                items.innerHTML = cart.length === 0 ? '<p class="empty-msg">Nenhum hardware detectado.</p>' : cart.map(p => `
                    <div style="padding:15px 0; border-bottom:1px solid rgba(255,255,255,0.05); display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-weight:700; font-size:0.85rem;">${p.name}</span>
                        <span style="color:var(--accent); font-weight:800; font-size:0.85rem;">${p.price}</span>
                    </div>`).join('');
                const sum = cart.reduce((acc, p) => acc + parseFloat(p.price.replace('R$', '').replace('.', '').replace(',', '.')), 0);
                totalDisplay.innerText = `R$ ${sum.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            };
        
            window.addToCart = (name, price) => {
                cart.push({name, price});
                updateCartUI();
                document.getElementById('cart-sidebar').classList.add('active');
            };
        
            // 2. CURSOR ULTRA SMOOTH
            const cursor = document.getElementById('custom-cursor');
            document.addEventListener('mousemove', (e) => {
                cursor.style.opacity = "1";
                gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0.1 });
            });
        
            // 3. INTERAÇÃO DE FOCO NOS CARDS
			const cards = document.querySelectorAll('.card');
			cards.forEach(card => {
				const img = card.querySelector('.prod-img');
				card.addEventListener('mouseenter', () => {
					gsap.to("body", { backgroundColor: "#010101", duration: 0.5 });
					gsap.to(cards, { opacity: 0.15, filter: "blur(6px)", duration: 0.5 });
					gsap.to(card, { opacity: 1, filter: "blur(0px)", y: -10, borderColor: "rgba(0, 242, 255, 0.5)", duration: 0.5 });
					if (img) gsap.to(img, { y: -15, scale: 1.06, duration: 0.6 });
				});

				card.addEventListener('mouseleave', () => {
					gsap.to("body", { backgroundColor: "#030303", duration: 0.5 });
					gsap.to(cards, { opacity: 1, filter: "blur(0px)", y: 0, borderColor: "rgba(255,255,255,0.06)", duration: 0.5 });
					if (img) gsap.to(img, { y: 0, scale: 1, duration: 0.6 });
				});
			});
        
            // 4. UI TRIGGERS (CHAT E CARRINHO)
            const chatWin = document.getElementById('chatWindow');
            const aiTrigger = document.getElementById('toggleChat');
            const closeChatBtn = document.getElementById('closeChat');
            const cartSidebar = document.getElementById('cart-sidebar');
            const openCartBtn = document.getElementById('open-cart');
            const closeCartBtn = document.getElementById('close-cart');
            const sendBtn = document.getElementById('sendBtn');
            const userInput = document.getElementById('userInput');
			const chatTopic = document.getElementById('chatTopic');
			const chatMessages = document.getElementById('chatMessages');
			const chatHistory = [];
			const chatbotApiUrl = 'http://localhost:3000';

			const escapeHtml = (value) => String(value)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');

			const appendChatMessage = (role, text, id = '') => {
				const message = document.createElement('div');
				message.className = `msg ${role}`;
				if (id) message.id = id;
				message.innerHTML = `<div class="bubble">${escapeHtml(text)}</div>`;
				chatMessages?.appendChild(message);
				if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
				return message;
			};

			let initialChatMessageLoaded = false;
			let initialChatMessageLoading = false;

			const loadInitialChatMessage = async () => {
				if (initialChatMessageLoaded || initialChatMessageLoading || !chatMessages) return;
				initialChatMessageLoading = true;

				try {
					const res = await fetch(`${chatbotApiUrl}/api/chat/initial-message`);
					const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Não foi possível carregar a saudação.');
					chatMessages.innerHTML = '';
					appendChatMessage('bot', data.reply);
					initialChatMessageLoaded = true;
				} catch (error) {
					console.error('Erro ao carregar saudação do chatbot:', error);
				} finally {
					initialChatMessageLoading = false;
				}
			};

			aiTrigger.onclick = async (e) => {
                e.stopPropagation();
                chatWin.style.display = 'flex';
                gsap.from(chatWin, { y: 20, opacity: 0, duration: 0.3 });
				await loadInitialChatMessage();
            };

            closeChatBtn.onclick = (e) => {
                e.stopPropagation();
                chatWin.style.display = 'none';
            };

            openCartBtn.onclick = (e) => {
                e.stopPropagation();
                cartSidebar.classList.add('active');
            };

            closeCartBtn.onclick = (e) => {
                e.stopPropagation();
                cartSidebar.classList.remove('active');
            };

            // FECHAR AO CLICAR FORA
            window.addEventListener('click', (e) => {
                if (chatWin && chatWin.style.display === 'flex') {
                    if (!chatWin.contains(e.target) && !aiTrigger.contains(e.target)) {
                        chatWin.style.display = 'none';
                    }
                }

                if (cartSidebar && cartSidebar.classList.contains('active')) {
                    const isBuyBtn = e.target.classList.contains('buy-btn');
                    if (!cartSidebar.contains(e.target) && !openCartBtn.contains(e.target) && !isBuyBtn) {
                        cartSidebar.classList.remove('active');
                    }
                }
            });

            // 5. LÓGICA DE MENSAGEM DA IA
            const handleSendMessage = async () => {
                const text = userInput.value.trim();
				if (!text || sendBtn.disabled) return;
				const topic = chatTopic.value;
				appendChatMessage('user', text);
				chatHistory.push({ role: 'user', text });
                userInput.value = "";

                const tempId = Date.now();
				appendChatMessage('bot', 'Processando sua solicitação...', `temp-${tempId}`);
				sendBtn.disabled = true;

                try {
					const res = await fetch(`${chatbotApiUrl}/api/chat`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ message: text, topic, history: chatHistory.slice(0, -1) }),
					});
                    const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Não foi possível processar a mensagem.');
					document.getElementById(`temp-${tempId}`)?.remove();
					appendChatMessage('bot', data.reply);
					chatHistory.push({ role: 'model', text: data.reply });
                } catch (err) {
                    const tempElem = document.getElementById(`temp-${tempId}`);
					if (tempElem) tempElem.querySelector('.bubble').textContent = err.message || 'Erro na conexão neural.';
				} finally {
					sendBtn.disabled = false;
					userInput.focus();
                }
            };

            sendBtn.onclick = handleSendMessage;
            userInput.onkeypress = (e) => { if(e.key === 'Enter') handleSendMessage(); };
        
            // 6. EFEITO MAGNÉTICO
            document.querySelectorAll('.magnetic').forEach(btn => {
                btn.addEventListener('mousemove', (e) => {
                    const pos = btn.getBoundingClientRect();
                    const x = (e.pageX - pos.left - pos.width/2) * 0.3;
                    const y = (e.pageY - pos.top - pos.height/2) * 0.3;
                    gsap.to(btn, { x, y, duration: 0.3 });
                });
                btn.addEventListener('mouseleave', () => gsap.to(btn, { x: 0, y: 0, duration: 0.5 }));
            });
        </script>
	</body>
</html>