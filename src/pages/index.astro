---
// TECHNOVA - EDIÇÃO PRESTIGE ULTRA (FOCO IMERSIVO & FULL FUNCTIONAL)
---

<html lang="pt-br">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>TECHNOVA | Prestige Tech Experience</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
	</head>
	<body>
		
		<div id="custom-cursor"></div>

		<!-- CARRINHO LATERAL -->
		<div id="cart-sidebar" class="sidebar">
			<div class="sidebar-header">
				<h3>ECOSSISTEMA</h3>
				<button id="close-cart" class="close-btn-generic">×</button>
			</div>
			<div id="cart-items" class="cart-scroll-area">
				<p class="empty-msg">Nenhum hardware detectado.</p>
			</div>
			<div class="sidebar-footer">
				<div class="total-row">
					<span>TOTAL</span>
					<span id="cart-total">R$ 0,00</span>
				</div>
				<button class="checkout-btn magnetic">FINALIZAR ORDEM</button>
			</div>
		</div>

		<!-- NAVBAR REFINADA -->
		<nav class="navbar">
			<div class="logo">TECH<span>NOVA</span></div>
			<div class="nav-links">
				<a href="#grid" class="nav-item magnetic">SHOP</a>
				<a href="#" class="nav-item magnetic">LABS</a>
			</div>
			<button class="cart-trigger magnetic" id="open-cart">
				CART [<span id="cart-count">0</span>]
			</button>
		</nav>

		<main id="main-content">
			<section class="hero">
				<div class="hero-container">
					<div class="badge">ESTOQUE LIMITADO</div>
					<h1 class="reveal-text">TECH</h1>
					<h1 class="reveal-text gradient">PERFORMANCE</h1>
					<p class="hero-subtext">Engenharia quântica e design minimalista em um único ecossistema funcional.</p>
					<button class="cta-primary magnetic" onclick="document.getElementById('grid').scrollIntoView({behavior:'smooth'})">
						EXPLORAR PRODUTOS <span class="arrow">↓</span>
					</button>
				</div>
			</section>

			<section class="products-section">
				<div class="section-header">
					<h2 class="section-label">EQUIPAMENTOS DE ELITE</h2>
					<div class="line"></div>
				</div>
				<div class="product-grid" id="grid">
					<!-- Injetado via JS -->
				</div>
			</section>
		</main>

		<!-- SUPORTE IA -->
        <div class="ai-trigger-wrapper" id="toggleChat">
            <div class="ai-orb">
                <div class="orb-rings"></div>
                <div class="orb-core"></div>
            </div>
            <span class="orb-label">SUPORTE</span>
        </div>
        
        <div class="chat-window" id="chatWindow">
            <div class="chat-header">
                <div class="header-content">
                    <div class="status-dot"></div>
                    <div class="text-block">
                        <span class="ai-title">Suporte de Atendimento</span>
                        <span class="ai-status">Online agora</span>
                    </div>
                </div>
                <button id="closeChat" class="close-btn-chat">×</button>
            </div>
            <div class="messages" id="chatMessages">
                <div class="msg bot">
                    <div class="bubble">Sistemas prontos. Como posso auxiliar em sua jornada?</div>
                </div>
            </div>
            <div id="chat-loader" class="skeleton-container" style="display:none">
                <div class="skeleton-line"></div>
            </div>
            <div class="chat-input-area">
                <input type="text" id="userInput" placeholder="O que você precisa?">
                <button id="sendBtn" class="magnetic">➤</button>
            </div>
        </div>

		<style>
			:root {
				--bg: #030303;
				--accent: #00f2ff;
				--accent-2: #7000ff;
				--glass: rgba(255, 255, 255, 0.03);
			}

			* { margin: 0; padding: 0; box-sizing: border-box; cursor: none !important; }
			body { background: var(--bg); color: white; font-family: 'Inter', sans-serif; overflow-x: hidden; transition: background 0.6s cubic-bezier(0.2, 1, 0.2, 1); }

			/* CURSOR */
			#custom-cursor {
				position: fixed; top: 0; left: 0; width: 12px; height: 12px;
				background: var(--accent); border-radius: 50%; pointer-events: none;
				z-index: 10000; mix-blend-mode: difference; transform: translate(-50%, -50%);
				opacity: 0; transition: width 0.3s, opacity 0.3s;
			}

			/* NAVBAR */
			.navbar { position: fixed; width: 100%; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 30px 5%; backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.05); }
			.logo { font-weight: 900; letter-spacing: 3px; }
			.logo span { color: var(--accent); }
			.nav-links { display: flex; gap: 50px; }
			.nav-item { text-decoration: none; color: white; font-size: 0.7rem; font-weight: 700; letter-spacing: 2px; opacity: 0.5; transition: 0.3s; }
			.nav-item:hover { opacity: 1; color: var(--accent); }
			.cart-trigger { background: white; color: black; border: none; padding: 12px 25px; border-radius: 50px; font-weight: 900; font-size: 0.65rem; transition: 0.3s; }

			/* HERO */
			.hero { height: 100vh; display: flex; align-items: center; padding: 0 10%; }
			.badge { font-size: 0.6rem; letter-spacing: 3px; color: var(--accent); margin-bottom: 20px; border: 1px solid var(--accent); display: inline-block; padding: 5px 15px; border-radius: 50px; }
			h1 { font-size: clamp(4rem, 12vw, 9rem); font-weight: 900; line-height: 0.8; letter-spacing: -6px; }
			.gradient { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
			.hero-subtext { max-width: 450px; margin: 30px 0; color: #666; font-size: 1.1rem; line-height: 1.6; }
			
			/* EXPLORAR BOTÃO */
			.cta-primary { background: white; color: black; border: none; padding: 25px 50px; font-weight: 900; font-size: 0.8rem; letter-spacing: 2px; transition: 0.4s; }
			.cta-primary:hover { background: var(--accent); border-radius: 50px; }

			/* GRID E FOCO IMERSIVO */
			.products-section { padding: 120px 5%; }
			.section-header { display: flex; align-items: center; gap: 20px; margin-bottom: 60px; }
			.section-label { font-size: 0.7rem; letter-spacing: 4px; color: #444; }
			.line { height: 1px; flex: 1; background: rgba(255,255,255,0.05); }
			
			.product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; }
			.card { 
				background: rgba(255,255,255,0.01); height: 550px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.05);
				padding: 40px; display: flex; flex-direction: column; justify-content: flex-end;
				transition: 0.6s cubic-bezier(0.16, 1, 0.3, 1); position: relative; overflow: hidden;
			}
			.card img { width: 85%; position: absolute; top: 10%; left: 7.5%; transition: 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
			
			/* BOTÃO COMPRAR */
			.buy-btn { 
				background: transparent; border: 1px solid rgba(255,255,255,0.1); color: white; 
				padding: 20px; border-radius: 15px; font-weight: 900; font-size: 0.7rem;
				letter-spacing: 2px; margin-top: 30px; transition: 0.4s;
			}
			.buy-btn:hover { background: white; color: black; }

			/* SIDEBAR */
			.sidebar { position: fixed; right: -450px; top: 0; width: 450px; height: 100vh; background: #050505; z-index: 2000; padding: 50px; transition: 0.6s cubic-bezier(0.85, 0, 0.15, 1); border-left: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; }
			.sidebar.active { right: 0; }
			.checkout-btn { width: 100%; padding: 22px; background: var(--accent); color: black; border: none; font-weight: 900; margin-top: 30px; letter-spacing: 2px; }

			/* IA E ORB */
            .ai-trigger-wrapper { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; align-items: center; gap: 5px; z-index: 1000; cursor: pointer; }
            .ai-orb { width: 60px; height: 60px; position: relative; display: flex; align-items: center; justify-content: center; }
            .orb-core { width: 30px; height: 30px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 25px var(--accent); }
            .orb-rings { position: absolute; width: 100%; height: 100%; border: 1px solid var(--accent); border-radius: 50%; opacity: 0.3; animation: pulseRing 2s infinite; }
            @keyframes pulseRing { 0% { transform: scale(0.8); opacity: 0.8; } 100% { transform: scale(1.4); opacity: 0; } }
            .orb-label { font-size: 9px; font-weight: 900; letter-spacing: 2px; color: var(--accent); }
            
            .chat-window { position: fixed; bottom: 100px; right: 30px; width: 360px; height: 500px; background: rgba(10,10,10,0.95); backdrop-filter: blur(25px); border-radius: 25px; border: 1px solid rgba(255,255,255,0.1); display: none; flex-direction: column; z-index: 1001; }
            .chat-header { padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; }
            .status-dot { width: 7px; height: 7px; background: #00ff88; border-radius: 50%; box-shadow: 0 0 10px #00ff88; }
            .ai-title { font-size: 0.8rem; font-weight: 800; color: white; display: block; }
            .ai-status { font-size: 0.65rem; color: #444; }
            .messages { flex: 1; overflow-y: auto; padding: 20px; font-size: 0.85rem; color: #ccc; }
		</style>

		<script>
			// --- LÓGICA DO CARRINHO ---
			let cart = [];
			const updateCartUI = () => {
				const count = document.getElementById('cart-count');
				const items = document.getElementById('cart-items');
				const totalDisplay = document.getElementById('cart-total');
				count.innerText = cart.length;
				items.innerHTML = cart.length === 0 ? '<p>Vazio.</p>' : cart.map(p => `<div style="padding:15px 0; border-bottom:1px solid #111; display:flex; justify-content:space-between"><span>${p.name}</span><span style="color:var(--accent)">${p.price}</span></div>`).join('');
				const sum = cart.reduce((acc, p) => acc + parseFloat(p.price.replace('R$', '').replace('.', '').replace(',', '.')), 0);
				totalDisplay.innerText = `R$ ${sum.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
			};

			window.addToCart = (name, price) => {
				cart.push({name, price});
				updateCartUI();
				document.getElementById('cart-sidebar').classList.add('active');
			};

			// --- CURSOR ---
			const cursor = document.getElementById('custom-cursor');
			document.addEventListener('mousemove', (e) => {
				cursor.style.opacity = "1";
				gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0.1 });
			});

			// --- PRODUTOS & FOCO IMERSIVO (REATIVADO) ---
			const products = [
				{ name: "NOVA BOOK ULTRA", price: "R$ 18.900,00", img: "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?q=80&w=500" },
				{ name: "QUANTUM GPU X", price: "R$ 7.500,00", img: "https://images.unsplash.com/photo-1591488320449-011701bb6704?q=80&w=500" },
				{ name: "CYBER WATCH S", price: "R$ 3.200,00", img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=500" }
			];

			const grid = document.getElementById('grid');
			products.forEach(p => {
				const card = document.createElement('div');
				card.className = 'card magnetic';
				card.innerHTML = `
					<img src="${p.img}" class="prod-img" />
					<h3 style="font-weight: 900; font-size: 1.5rem;">${p.name}</h3>
					<p style="color: var(--accent); margin-top: 10px; font-weight: 700;">${p.price}</p>
					<button class="buy-btn" onclick="addToCart('${p.name}', '${p.price}')">ADICIONAR À ORDEM</button>
				`;

				// INTERAÇÃO DE FOCO IMERSIVO
				card.addEventListener('mouseenter', () => {
					gsap.to("body", { backgroundColor: "#010101", duration: 0.5 });
					gsap.to(".card", { opacity: 0.1, filter: "blur(5px)", duration: 0.5 });
					gsap.to(card, { opacity: 1, filter: "blur(0px)", scale: 1.05, borderAll: "1px solid #00f2ff", duration: 0.5 });
					gsap.to(card.querySelector('img'), { scale: 1.1, y: -20, duration: 0.5 });
				});

				card.addEventListener('mouseleave', () => {
					gsap.to("body", { backgroundColor: "#030303", duration: 0.5 });
					gsap.to(".card", { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.5 });
					gsap.to(card.querySelector('img'), { scale: 1, y: 0, duration: 0.5 });
				});

				grid.appendChild(card);
			});

			// UI Triggers
			document.getElementById('toggleChat').onclick = () => document.getElementById('chatWindow').style.display = 'flex';
			document.getElementById('closeChat').onclick = () => document.getElementById('chatWindow').style.display = 'none';
			document.getElementById('open-cart').onclick = () => document.getElementById('cart-sidebar').classList.add('active');
			document.getElementById('close-cart').onclick = () => document.getElementById('cart-sidebar').classList.remove('active');

			// Magnetic Effect
			const applyMagnetic = () => {
				document.querySelectorAll('.magnetic').forEach(btn => {
					btn.addEventListener('mousemove', (e) => {
						const pos = btn.getBoundingClientRect();
						const x = (e.pageX - pos.left - pos.width/2) * 0.3;
						const y = (e.pageY - pos.top - pos.height/2) * 0.3;
						gsap.to(btn, { x, y, duration: 0.3 });
					});
					btn.addEventListener('mouseleave', () => gsap.to(btn, { x: 0, y: 0, duration: 0.5 }));
				});
			};
			applyMagnetic();

			// IA Logic
			const sendBtn = document.getElementById('sendBtn');
			sendBtn.onclick = async () => {
				const input = document.getElementById('userInput');
				const messages = document.getElementById('chatMessages');
				if(!input.value) return;
				messages.innerHTML += `<div class="msg user" style="text-align:right; color:var(--accent-2)"><b>Você:</b> ${input.value}</div>`;
				const prompt = input.value;
				input.value = "";
				const res = await fetch('/api/chat', { method: 'POST', body: JSON.stringify({ message: prompt }) });
				const data = await res.json();
				messages.innerHTML += `<div class="msg bot" style="margin-top:10px"><b>AI:</b> ${data.text}</div>`;
				messages.scrollTop = messages.scrollHeight;
			};
		</script>
	</body>
</html>